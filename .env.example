# ── NewsTrader — configuration d'environnement ──────────────────────────────
# Copier ce fichier en `.env` à la racine, puis remplir les valeurs.
# Les clés API sensibles ne vont PAS ici : elles vont dans le fichier chiffré
# secrets/credentials.enc.json (voir README, section "Secrets").

# Clé maître qui déchiffre secrets/credentials.enc.json.
# À générer avec :  python -m app.secrets gen-key
MASTER_KEY=

# Jeton d'accès à l'API du core (utilisé par la PWA et n8n).
# À générer avec :  openssl rand -hex 32
API_TOKEN=

# Base de données (le docker-compose fournit ce Postgres)
DATABASE_URL=postgresql+psycopg://newstrader:newstrader@db:5432/newstrader
POSTGRES_USER=newstrader
POSTGRES_PASSWORD=newstrader
POSTGRES_DB=newstrader

# Capital de départ du paper trading (en EUR)
START_CAPITAL=10000

# Fuseau horaire des rapports et du scheduler
TZ=Europe/Paris

# Port exposé de la PWA sur le NAS
WEB_PORT=8480
