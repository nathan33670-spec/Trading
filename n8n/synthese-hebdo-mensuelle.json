        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Token", "value": "={{ $env.NEWSTRADER_API_TOKEN }}" }
          ]
        }
      },
      "name": "Générer synthèse hebdo",
      "type": "n8n-nodes-base.httpRequest",
